# Copy to .env and supply real values locally or in hosting secrets.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_HOST=
DB_NAME=medguard
PORT=5001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
FIREBASE_PROJECT_ID=medguard-ai-8e484
GEMINI_API_KEY=
# Comma-separated Web deployment origins; localhost/LAN dev origins are allowed.
CORS_ORIGINS=
# Password recovery needs a real SMTP account; use port 465 for implicit TLS or 587 with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ClamAV must be reachable on a PRIVATE network; never expose clamd publicly.
CLAMAV_HOST=
CLAMAV_PORT=3310
VAULT_SCAN_REQUIRED=true
# Populate with the actual hosting backup retention after verification.
BACKUP_RETENTION_DAYS=
HOSPITAL_PROVIDER_CONTACT=

# Fail closed if signature database is older than this (1-168 hours).
CLAMAV_MAX_SIGNATURE_AGE_HOURS=72
